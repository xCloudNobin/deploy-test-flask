# Safe example values for local development only.
# Copy to .env or export these before starting the app in production.
# Never commit real credentials or private database paths.

# Bind address and port. The app binds 0.0.0.0 so the platform can reach it.
PORT=8000
HOST=0.0.0.0

# Persistent SQLite database path. For production deployments point this at
# storage OUTSIDE the release checkout (e.g. a mounted volume), otherwise
# data is lost on redeploy:  /var/lib/taskboard/tasks.db
DATABASE_PATH=./data/tasks.db

# Seconds sqlite3 waits for a lock before failing. 0 disables the wait.
DATABASE_TIMEOUT=5

# Random secret used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Keep it stable across restarts so sessions (and CSRF tokens) survive.
SECRET_KEY=change-me-generate-a-random-value

# Optional non-sensitive build marker shown in the UI footer to identify
# the deployed revision.
BUILD_MARKER=dev

# Set to 1 to run the Flask development server (do not use in production).
FLASK_DEBUG=0